-- Pętla automatycznych komend działająca płynnie co rundę
task.spawn(function()
    local sentThisRound = false
    while true do
        if isInLobbyOrEnded() then
            -- Gdy gra wchodzi w stan lobby/konta rundy, resetujemy flagę
            sentThisRound = false 
        else
            -- Gdy zaczyna się nowa runda i jeszcze nie wysłano komend
            if not sentThisRound then
                task.wait(1.5) -- Krótkie opóźnienie na załadowanie mapy
                sendChatCommand("/map Milbase")
                task.wait(0.5)
                sendChatCommand("/sheriff " .. LocalPlayer.Name)
                task.wait(0.5)
                sendChatCommand("/murderer " .. LocalPlayer.Name)
                
                sentThisRound = true -- Komendy wysłane, czekamy na nową rundę
            end
        end
        task.wait(1)
    end
end)
